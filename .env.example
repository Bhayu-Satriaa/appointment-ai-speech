APP_NAME="Klinik Sehat Bersama"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ------------------------------------------------------------------ Database
# Proyek ini butuh MySQL. Buat dulu databasenya:
#   CREATE DATABASE appointment_poc CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=appointment_poc
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# =====================================================================
#  KUNCI API — WAJIB DIISI SENDIRI
#  Jangan pernah commit file .env. File ini hanya contoh.
# =====================================================================

# --- Suara (resepsionis digital) --------------------------------------
# Ambil gratis di https://aistudio.google.com/apikey
# Tanpa key ini aplikasi tetap jalan untuk chat teks, tombol "Bicara"
# akan menampilkan pesan bahwa layanan suara belum siap.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=models/gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_LIVE_VOICE=Kore

# --- Otak percakapan teks (endpoint OpenAI-compatible) ----------------
# Bisa diarahkan ke penyedia mana pun yang kompatibel dengan OpenAI:
#   - OpenAI    : https://api.openai.com/v1
#   - Groq      : https://api.groq.com/openai/v1
#   - OpenRouter: https://openrouter.ai/api/v1
#   - Server sendiri / gateway lokal: http://127.0.0.1:20128/v1
LLM_BASE_URL=https://api.openai.com/v1

# Isi dengan API key milikmu sendiri. Ambil dari dashboard penyedia.
LLM_API_KEY=

# Model utama dan cadangan. Sesuaikan nama model dengan penyedia yang dipakai.
LLM_MODEL=gpt-4o-mini
LLM_MODEL_FALLBACK=gpt-4o-mini

# Batas token keluaran. Setiap token tambahan menambah waktu tunggu;
# tanpa batas, model bisa menulis sepanjang yang ia mau.
LLM_MAX_TOKENS=300
